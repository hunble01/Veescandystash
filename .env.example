# Copy this file to .env.local and fill in values as each account is set up.
# Never commit .env.local: it holds secrets. On Netlify, add the same names
# under Site configuration → Environment variables.

# Public URL of the site (used for Stripe return links). Optional locally.
NEXT_PUBLIC_SITE_URL=

# --- Sanity (product editor + order inbox) ---
# sanity.io/manage → your project → Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# API → Tokens. "Viewer" token: lets the site read a private dataset.
SANITY_API_READ_TOKEN=
# API → Tokens. "Editor" token: lets the site save orders, requests and messages.
SANITY_API_WRITE_TOKEN=

# --- Stripe (payments) ---
# dashboard.stripe.com → Developers → API keys. Use sk_test_… until launch.
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint https://<your-site>/api/stripe/webhook,
# events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=
# Optional: Products → Tax rates → create HST rate, paste its id (txr_…).
STRIPE_TAX_RATE_ID=

# --- Resend (emails to Vee about orders, requests and messages) ---
RESEND_API_KEY=
# Where notifications go (Vee's inbox).
NOTIFY_EMAIL_TO=
# Optional until you verify your own domain in Resend.
NOTIFY_EMAIL_FROM=

# --- Clerk (customer logins, incl. "Continue with Google") ---
# dashboard.clerk.com → your app → API keys. While testing locally the site can
# run without these (Clerk makes temporary keys); real keys are needed to launch.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
